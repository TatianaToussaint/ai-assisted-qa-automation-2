DIDAXIS_URL=https://test.didaxis.studio
DIDAXIS_EMAIL=your-admin-email@example.com
DIDAXIS_PASSWORD=your-password-here
# DIDAXIS_API_TOKEN is optional — cleanup uses login API or Playwright MCP if needed
ATLASSIAN_BASE_URL=https://your-org.atlassian.net
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=your-api-token-here
JIRA_PROJECT_KEY=DS
JIRA_LOGIN_EMAIL=your-email@example.com
JIRA_LOGIN_PASSWORD=your-password-here

# GitHub CLI + MCP (fine-grained PAT with repo + actions:read)
GITHUB_TOKEN=ghp_your_token_here
# Cursor GitHub MCP reads this from your OS environment (~/.cursor/mcp.json uses ${env:GITHUB_PERSONAL_ACCESS_TOKEN})
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here
